# MongoDB connection string (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=agentforge

# CORS origins (comma-separated, defaults to *)
CORS_ORIGINS=*

# Optional: DeepSeek API key for live agent mode (game works fully without it)
# DEEPSEEK_API_KEY=

# Test mode: set to true to unlock all content for QA/testing
UNLOCK_ALL=false
